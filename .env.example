# ===== 1. 权限与安全配置 =====
# 生产环境请改成一长串随机字符串
JWT_SECRET_KEY=change-this-to-a-long-random-secret-key
JWT_EXPIRE_MINUTES=120

# ===== 2. 对话大模型配置（DeepSeek / 任意 OpenAI 兼容接口）=====
LLM_API_KEY=sk-你的DeepSeek_API_Key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ===== 3. 向量模型配置（硅基流动 BAAI/bge-m3）=====
EMBED_API_KEY=sk-你的硅基流动_API_Key
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_MODEL=BAAI/bge-m3

# ===== 4. Flask 前端配置 =====
FLASK_SECRET_KEY=change-this-flask-session-secret
# 后端 FastAPI 地址（本地联调用 127.0.0.1，云端联调改成 http://<ECS公网IP>:8000）
BACKEND_API_URL=http://127.0.0.1:8000
